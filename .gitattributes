# Line-ending policy: auto-detect text, store LF in the repo, check out native.
# Prevents the CRLF<->LF churn that WSL2/Windows checkouts produced on shaders
# and data files. Binary formats below are exempted from any conversion.
* text=auto
# Shell scripts MUST stay LF (CRLF breaks bash on Linux — e.g. build scripts).
*.sh text eol=lf
# MU client binary formats — never apply text/CRLF conversion to these.
# Treating them as text causes silent corruption when autocrlf is enabled.
# MU proprietary data
*.main binary
*.bmd binary
*.bin binary
*.obj binary
*.lib binary
*.smd binary
*.att binary
*.cap binary
*.ozb binary
*.ozt binary
*.ozj binary
*.ozg binary
*.ozm binary
*.ozd binary
*.osk binary
# Executables / native modules
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll binary
*.pdb binary
# Images / textures
*.bmp binary
*.tga binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.dds binary
# Audio / video
*.wav binary
*.mp3 binary
*.ogg binary
*.aac binary
*.wma binary
*.avi binary
*.mp4 binary
# Archives
*.zip binary
*.rar binary
*.7z binary
*.cab binary
*.iso binary
ClientFile/libgallium_wgl.dll filter=lfs diff=lfs merge=lfs -text
