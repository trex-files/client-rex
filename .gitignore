# MSVC build residues left behind when Main.exe is compiled
# (the binary itself, Main.exe, IS tracked — we only exclude residues)

**/*.pdb
**/*.exp
**/*.ilk
**/*.idb
**/*.iobj
**/*.ipdb
**/*.tlog
**/*.lastbuildstate
**/*.exe.recipe
**/*.exe.intermediate.manifest

# Linker leftover with no extension (rare, but seen on some setups)
ClientFile/Main

# Main.exe import library — anchored to ClientFile/ root only.
# (We can't ignore *.lib globally because MU may reuse the extension.)
ClientFile/Main.lib

# NOTE: We do NOT ignore *.obj or *.lib globally — MU client reuses those
# extensions for game data (e.g. EncTerrain*.obj).

# Temporary round-trip backups left by the GlobalText (.bmd) tooling
ClientFile/Data/Local/**/*.bmd.pre-*.bak

# Local screenshots dropped by the player
ClientFile/Screenshots/

# Runtime crash dumps written by the client's __try/__except handler
ClientFile/STACK_ERROR/

# Runtime error log written when LoadBitmap / asset loaders fail
ClientFile/REX.txt

# Boot logs from the gl3 engine bridge (engine_bridge::Init)
ClientFile/*.log

# OS / IDE noise
.vs/
*.suo
*.user
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store

# Local minimap capture/polish scratch (pre-edit copies like
# _World9_backup_pre_polish/, World11/_backup_pre_blackbg/) — never commit.
ClientFile/Data/Minimaps/**/*backup*/
* - copia.*

# Internal reports - never commit
**/reports/

# Windows Explorer folder cruft — never ship or track these
**/Thumbs.db
**/desktop.ini

# Stale manual .bmd backups (the .pre-* tooling pattern above is separate)
**/*.bmd.bak

# Archivos comprimidos / caches de tooling que NO deben empaquetarse ni trackearse
**/*.rar
**/*.zip
**/*.7z
**/.ruff_cache/

# Salidas de build: instalador y zips de parche. Se regeneran.
# Los manifiestos que SI se versionan viven en patch-manifests/.
installer/Output/
patch-out/

# ============================================================
# Backups de trabajo de agentes/herramientas. Se crean al vuelo
# antes de una edicion arriesgada (encodings EUC-KR, .bmd, .dat)
# y NUNCA deben versionarse: son copias efimeras del working tree.
# ============================================================
*.bak-*
.bak-*/
*.ssemu-legacy
*.pre-*.bak
